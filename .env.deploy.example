# Copy this file to .env.deploy (git-ignored) and fill in your values.
# Real environment variables always override values here.
# Full guide: docs/SELF-HOSTING.md (or docs/AGENT-SETUP.md for AI agents).

# Required
PULSE_DOMAIN=pulse.example.com
PULSE_D1_ID=00000000-0000-0000-0000-000000000000
PULSE_KV_ID=0123456789abcdef0123456789abcdef

# Dashboard sign-in via Cloudflare Access (both required together; omit both to run API/MCP/tracker only)
PULSE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
PULSE_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional
# PULSE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# PULSE_ALERT_FROM=alerts@example.com
# PULSE_ALERT_TO=you@example.com
# PULSE_JURISDICTION=eu            # eu (default), fedramp, or none
# PULSE_OPS_BACKUPS=true           # set to false if you didn't create the ops-backups R2 bucket
